
use builtin;
use str;

set edit:completion:arg-completer[sibling] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'sibling'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'sibling'= {
            cand -f 'print the result in the specified format'
            cand --format 'print the result in the specified format'
            cand -s 'specify the number of times to execute sibling. The negative count traverses in the opposite direction, and 0 means the current directory'
            cand --step 'specify the number of times to execute sibling. The negative count traverses in the opposite direction, and 0 means the current directory'
            cand -t 'specify the nexter type'
            cand --type 'specify the nexter type'
            cand -b 'specify the parent directory of DIR (default: the parent directory of DIR)'
            cand --base-path 'specify the parent directory of DIR (default: the parent directory of DIR)'
            cand -A 'print the directory name in the absolute path'
            cand --absolute 'print the directory name in the absolute path'
            cand -p 'print the progress of traversing directories'
            cand --progress 'print the progress of traversing directories'
            cand -a 'Set the targets to all directories from the given list. By default, the sibling skips non-existent directories.'
            cand --all 'Set the targets to all directories from the given list. By default, the sibling skips non-existent directories.'
            cand -h 'Print help'
            cand --help 'Print help'
        }
    ]
    $completions[$command]
}
