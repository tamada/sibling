#compdef sibling

autoload -U is-at-least

_sibling() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-f+[print the result in the specified format]:FORMAT:(json csv list default)' \
'--format=[print the result in the specified format]:FORMAT:(json csv list default)' \
'-s+[specify the number of times to execute sibling. The negative count traverses in the opposite direction, and 0 means the current directory]:COUNT:_default' \
'--step=[specify the number of times to execute sibling. The negative count traverses in the opposite direction, and 0 means the current directory]:COUNT:_default' \
'-t+[specify the nexter type]:TYPE:(first last previous next random keep)' \
'--type=[specify the nexter type]:TYPE:(first last previous next random keep)' \
'-b+[specify the parent directory of DIR (default\: the parent directory of DIR)]:DIR:_files' \
'--base-path=[specify the parent directory of DIR (default\: the parent directory of DIR)]:DIR:_files' \
'-A[print the directory name in the absolute path]' \
'--absolute[print the directory name in the absolute path]' \
'-p[print the progress of traversing directories]' \
'--progress[print the progress of traversing directories]' \
'-a[Set the targets to all directories from the given list. By default, the sibling skips non-existent directories.]' \
'--all[Set the targets to all directories from the given list. By default, the sibling skips non-existent directories.]' \
'-h[Print help]' \
'--help[Print help]' \
'::input -- the directory to find its siblings, or the file of directory list:_default' \
&& ret=0
}

(( $+functions[_sibling_commands] )) ||
_sibling_commands() {
    local commands; commands=()
    _describe -t commands 'sibling commands' commands "$@"
}

if [ "$funcstack[1]" = "_sibling" ]; then
    _sibling "$@"
else
    compdef _sibling sibling
fi
